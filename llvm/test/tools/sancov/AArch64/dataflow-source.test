## Check that `sancov -symbolize-dataflow` resolves each trace-args/trace-ret
## observation through its observation descriptor and the compiler's debug-only
## source map to the source parameter, and which bits of it, it holds; that
## the observation survives stripping debug information; and that without the
## source map it falls back to a positional guess that is labelled as one, and
## only where no split aggregate or hidden argument makes it ambiguous.
##
## The input is what clang -O2 -g emits for the argument shapes of
## dataflow-dwarf-experiment on aarch64-linux-gnu. AArch64 passes `struct mix` as one `[2 x i64]`, two observations of IR
## argument 0, so `z` is IR argument 1; `struct hfa` is `[3 x float]`.
##
## The object is relocatable and calls callbacks it does not define: the
## descriptors locate the call sites through their relocations.

REQUIRES: aarch64-registered-target
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args -sanitizer-coverage-trace-ret \
RUN:   %S/../../../Instrumentation/SanitizerCoverage/Inputs/trace-args-cases-aarch64.ll -S -o %t.ll
RUN: llc -O2 -filetype=obj %t.ll -o %t.o
RUN: sancov -symbolize-dataflow %t.o > %t.json
RUN: grep '"summary"' %t.json | FileCheck %s --check-prefix=EXACT --match-full-lines

## Debug information stripped: the IR-level observations stay, the source does
## not.
RUN: llvm-objcopy --strip-debug %t.o %t.stripped.o
RUN: sancov -symbolize-dataflow %t.stripped.o > %t.stripped.json
RUN: grep '"summary"' %t.stripped.json | FileCheck %s --check-prefix=STRIPPED --match-full-lines
RUN: FileCheck %s --check-prefix=STRIPPED-OBS < %t.stripped.json

## The source map absent, as from a compiler that does not emit it.
RUN: sed -e 's/ !sancov.dataflow ![0-9]*//' %t.ll | llc -O2 -filetype=obj -o %t.nomap.o
RUN: sancov -symbolize-dataflow %t.nomap.o > %t.nomap.json
RUN: grep '"summary"' %t.nomap.json | FileCheck %s --check-prefix=NOMAP --match-full-lines

EXACT:     "summary": "IR argument 0 -> source parameter \"a\" [exact: compiler source map]",
EXACT-NEXT:"summary": "IR argument 1 -> source parameter \"b\" [exact: compiler source map]",
EXACT-NEXT:"summary": "return value -> type \"long\" [exact: subprogram return type]",
EXACT-NEXT:"summary": "IR argument 0 -> source parameter \"p\" [exact: compiler source map]",
