## A trace call inlined after instrumentation, as LTO may do, observes the IR
## arguments of the function it was instrumented in, not of the one it is in
## now. sancov does not apply a source map to it - the map belongs to the
## out-of-line function - and falls back to a positional guess, labelled as one,
## against the parameters of the inlined subroutine.

REQUIRES: x86-registered-target
RUN: split-file %s %t
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args -sanitizer-coverage-trace-ret %t/inl.ll \
RUN:   | opt -passes=always-inline,globaldce -o %t/inl.bc
RUN: llc -O2 -filetype=obj %t/inl.bc -o %t/inl.o
RUN: sancov -symbolize-dataflow %t/inl.o | FileCheck %s

CHECK:      "function": "outer",
CHECK:      "summary": "IR argument 0 -> source parameter \"a\" [exact: compiler source map]",
CHECK:      "function": "leaf",
CHECK-NEXT: "file": "/inl.c",
CHECK:      "function": "outer",
CHECK:      "summary": "IR argument 0 -> source parameter \"x\" [heuristic: positional]",
CHECK:      "function": "leaf",
CHECK:      "summary": "return value -> type \"int\" [exact: subprogram return type]",
CHECK:      "function": "outer",
CHECK:      "summary": "return value -> type \"int\" [exact: subprogram return type]",

;--- inl.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define internal i32 @leaf(i32 noundef %x) alwaysinline !dbg !10 {
entry:
    #dbg_value(i32 %x, !13, !DIExpression(), !14)
  %r = add i32 %x, 1, !dbg !14
  ret i32 %r, !dbg !14
}

define i32 @outer(i32 noundef %a) !dbg !20 {
entry:
    #dbg_value(i32 %a, !21, !DIExpression(), !22)
  %c = call i32 @leaf(i32 %a), !dbg !22
  ret i32 %c, !dbg !22
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2, !3}
!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
!1 = !DIFile(filename: "inl.c", directory: "/")
!2 = !{i32 7, !"Dwarf Version", i32 5}
!3 = !{i32 2, !"Debug Info Version", i32 3}
!4 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!5 = !DISubroutineType(types: !6)
!6 = !{!4, !4}
!10 = distinct !DISubprogram(name: "leaf", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagLocalToUnit | DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !15)
!13 = !DILocalVariable(name: "x", arg: 1, scope: !10, file: !1, line: 1, type: !4)
!14 = !DILocation(line: 1, column: 1, scope: !10)
!15 = !{!13}
!20 = distinct !DISubprogram(name: "outer", scope: !1, file: !1, line: 5, type: !5, scopeLine: 5, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !23)
!21 = !DILocalVariable(name: "a", arg: 1, scope: !20, file: !1, line: 5, type: !4)
!22 = !DILocation(line: 6, column: 3, scope: !20)
!23 = !{!21}
