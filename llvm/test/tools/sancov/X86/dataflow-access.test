## Check that `sancov -symbolize-dataflow` decodes the version 2 descriptors of
## access records (-sanitizer-coverage-trace-pointee-access) and resolves each
## to the members of what the pointer argument points to that the accessed
## bytes overlap, wholly or in part. The input is what clang -O2 -g emits for
##
##   struct inner { int x; short y; };
##   struct outer { long id; struct inner in; unsigned char tag[4]; };
##   struct bits { unsigned a : 3, b : 5; };
##   union u { int i; float f; };
##   struct link { struct link *next; };
##   struct item { int key; struct link l; };
##   static inline __attribute__((always_inline)) int y_of(struct outer *o) { return o->in.y; }
##   int fields(struct outer *o) { return o->in.x + y_of(o) + o->tag[3]; }
##   void store(struct outer *o, int v) { o->in.x = v; }
##   unsigned bitfield(struct bits *p) { return p->b; }
##   unsigned char low_byte(struct inner *p) { return *(unsigned char *)&p->x; }
##   int as_int(union u *p) { return p->i; }
##   int key(struct link *l) { return ((struct item *)((char *)l - 8))->key; }
##   int second(struct inner *p) { return p[1].x; }
##   __int128 wide(__int128 *p) { return *p; }
##   int vol(volatile int *p) { return *p; }
##   void publish(long *p, long v) { __atomic_store_n(p, v, __ATOMIC_RELEASE); }
##
## An access record is the value of one load or store, not the pointee's state:
## no other member is described.

REQUIRES: x86-registered-target
RUN: split-file %s %t
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args \
RUN:   -sanitizer-coverage-trace-pointee-access -sanitizer-coverage-trace-pointee-access-volatile \
RUN:   -sanitizer-coverage-trace-pointee-access-atomic %t/access.ll -o %t/access.bc
RUN: llc -O2 -filetype=obj %t/access.bc -o %t/access.o
RUN: sancov -symbolize-dataflow %t/access.o > %t/access.json
RUN: FileCheck %s --check-prefix=SUMMARY --input-file=%t/access.json
RUN: FileCheck %s --check-prefix=JSON --input-file=%t/access.json

## Every access, by its summary. The load of y_of(), inlined into fields(),
## is attributed to fields()'s parameter.
SUMMARY:      "summary": "IR argument 0 load of 4 bytes at offset 8 -> o->in.x [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 2 bytes at offset 12 -> o->in.y [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 1 byte at offset 19 -> o->tag[3] [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 store of 4 bytes at offset 8 -> o->in.x [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 1 byte at offset 0 -> p->a, p->b [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 1 byte at offset 0 -> p->x (part) [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 4 bytes at offset 0 -> p->i, p->f [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 4 bytes at offset -8 -> outside \"link\" through \"l\" [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 4 bytes at offset 8 -> p[1].x [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 8 bytes at offset 0 (piece 0 of a 16-byte access) -> *p (part) [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 load of 8 bytes at offset 8 (piece 1 of a 16-byte access) -> *p (part) [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 volatile load of 4 bytes at offset 0 -> *p [exact: compiler source map]"
SUMMARY:      "summary": "IR argument 0 atomic release store of 8 bytes at offset 0 -> *p [exact: compiler source map]"
SUMMARY-NOT:  "kind": "access"

## The inlined load: its own frames, the descriptor, and the member.
JSON:      "kind": "access",
JSON:      "kind": "access",
JSON-NEXT: "frames": [
JSON-NEXT:   {
JSON-NEXT:     "function": "y_of",
JSON:          "function": "fields",
JSON:      "observation": {
JSON-NEXT:   "ir_arg": 0,
JSON-NEXT:   "ir_args": 1,
JSON-NEXT:   "access": {
JSON-NEXT:     "kind": "load",
JSON-NEXT:     "offset": 12,
JSON-NEXT:     "access_size": 2,
JSON-NEXT:     "piece": 0
JSON-NEXT:   },
JSON-NEXT:   "class": "integer",
JSON-NEXT:   "size": 2,
JSON-NEXT:   "flags": [
JSON-NEXT:     "access"
JSON-NEXT:   ]
JSON-NEXT: },
JSON:      "parameter": {
JSON-NEXT:   "name": "o",
JSON:      "access": {
JSON-NEXT:   "object_type": "outer",
JSON-NEXT:   "members": [
JSON-NEXT:     {
JSON-NEXT:       "name": "in.y",
JSON-NEXT:       "expression": "o->in.y",
JSON-NEXT:       "type": "short",
JSON-NEXT:       "bit_offset": 96,
JSON-NEXT:       "bit_size": 16,
JSON-NEXT:       "value_bit_offset": 0,
JSON-NEXT:       "overlap_bits": 16
JSON-NEXT:     }
JSON-NEXT:   ]
JSON-NEXT: }

## Bit-fields: which bits of the loaded byte hold which member.
JSON:      "expression": "p->a",
JSON:        "bit_offset": 0,
JSON-NEXT:   "bit_size": 3,
JSON-NEXT:   "value_bit_offset": 0,
JSON-NEXT:   "overlap_bits": 3
JSON:      "expression": "p->b",
JSON:        "bit_offset": 3,
JSON-NEXT:   "bit_size": 5,
JSON-NEXT:   "value_bit_offset": 3,
JSON-NEXT:   "overlap_bits": 5

## Part of a member: the low byte of p->x.
JSON:      "expression": "p->x",
JSON:        "overlap_bits": 8,
JSON-NEXT:   "complete": false

## container_of: before the object the pointer's type describes.
JSON:      "offset": -8,
JSON:      "object_type": "link",
JSON-NEXT: "outside": true,
JSON-NEXT: "members": []

## The second piece of a 16-byte access holds the upper half of *p.
JSON:      "piece": 1
JSON:      "expression": "*p",
JSON:        "value_bit_offset": 0,
JSON-NEXT:   "member_bit_offset": 64,
JSON-NEXT:   "overlap_bits": 64,
JSON-NEXT:   "complete": false

JSON:      "volatile": true,
JSON:      "kind": "store",
JSON-NEXT: "atomic": "release",

## Without debug information, the descriptor alone: which argument, where,
## what kind and how wide; no member.
RUN: llvm-objcopy --strip-debug %t/access.o %t/stripped.o
RUN: sancov -symbolize-dataflow %t/stripped.o | FileCheck %s --check-prefix=STRIPPED
STRIPPED:      "kind": "access",
STRIPPED:      "access": {
STRIPPED-NEXT:   "kind": "load",
STRIPPED-NEXT:   "offset": 8,
STRIPPED-NEXT:   "access_size": 4,
STRIPPED-NEXT:   "piece": 0
STRIPPED:      "summary": "IR argument 0 load of 4 bytes at offset 8 -> source parameter unresolved (no debug information)"
STRIPPED-NOT:  "members"

## Access records with trace-args observations: the arguments' descriptors are
## still version 1, so both decode from one section.
RUN: sancov -symbolize-dataflow %t/access.o | FileCheck %s --check-prefix=BOTH
BOTH: "kind": "args",
BOTH: "kind": "access",

## The call sites alone: an access is a call site of its own kind.
RUN: sancov -print-dataflow-pcs %t/access.o | FileCheck %s --check-prefix=PCS
PCS: 0x{{[0-9a-f]+}} args
PCS: 0x{{[0-9a-f]+}} access

#--- access.ll
source_filename = "access.c"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define dso_local i32 @fields(ptr nofree noundef readonly captures(none) %o) local_unnamed_addr !dbg !28 {
entry:
    #dbg_value(ptr %o, !47, !DIExpression(), !48)
  %in = getelementptr inbounds nuw i8, ptr %o, i64 8, !dbg !49
  %0 = load i32, ptr %in, align 8, !dbg !50, !tbaa !51
    #dbg_value(ptr %o, !56, !DIExpression(), !59)
  %y.i = getelementptr inbounds nuw i8, ptr %o, i64 12, !dbg !61
  %1 = load i16, ptr %y.i, align 4, !dbg !62, !tbaa !63
  %conv.i = sext i16 %1 to i32, !dbg !64
  %add = add nsw i32 %0, %conv.i, !dbg !65
  %arrayidx = getelementptr inbounds nuw i8, ptr %o, i64 19, !dbg !66
  %2 = load i8, ptr %arrayidx, align 1, !dbg !66, !tbaa !67
  %conv = zext i8 %2 to i32, !dbg !66
  %add1 = add nsw i32 %add, %conv, !dbg !68
  ret i32 %add1, !dbg !69
}

define dso_local void @store(ptr nofree noundef writeonly captures(none) initializes((8, 12)) %o, i32 noundef %v) local_unnamed_addr !dbg !70 {
entry:
    #dbg_value(ptr %o, !74, !DIExpression(), !76)
    #dbg_value(i32 %v, !75, !DIExpression(), !76)
  %in = getelementptr inbounds nuw i8, ptr %o, i64 8, !dbg !77
  store i32 %v, ptr %in, align 8, !dbg !78, !tbaa !51
  ret void, !dbg !79
}

define dso_local range(i32 0, 32) i32 @bitfield(ptr nofree noundef readonly captures(none) %p) local_unnamed_addr !dbg !80 {
entry:
    #dbg_value(ptr %p, !90, !DIExpression(), !91)
  %bf.load = load i8, ptr %p, align 4, !dbg !92
  %bf.lshr = lshr i8 %bf.load, 3, !dbg !93
  %bf.cast = zext nneg i8 %bf.lshr to i32, !dbg !94
  ret i32 %bf.cast, !dbg !95
}

define dso_local zeroext i8 @low_byte(ptr nofree noundef readonly captures(none) %p) local_unnamed_addr !dbg !96 {
entry:
    #dbg_value(ptr %p, !101, !DIExpression(), !102)
  %0 = load i8, ptr %p, align 4, !dbg !103, !tbaa !67
  ret i8 %0, !dbg !104
}

define dso_local i32 @as_int(ptr nofree noundef readonly captures(none) %p) local_unnamed_addr !dbg !105 {
entry:
    #dbg_value(ptr %p, !115, !DIExpression(), !116)
  %0 = load i32, ptr %p, align 4, !dbg !117, !tbaa !67
  ret i32 %0, !dbg !118
}

define dso_local i32 @key(ptr nofree noundef readonly captures(none) %l) local_unnamed_addr !dbg !119 {
entry:
    #dbg_value(ptr %l, !123, !DIExpression(), !124)
  %add.ptr = getelementptr inbounds i8, ptr %l, i64 -8, !dbg !125
  %0 = load i32, ptr %add.ptr, align 8, !dbg !126, !tbaa !127
  ret i32 %0, !dbg !132
}

define dso_local i32 @second(ptr nofree noundef readonly captures(none) %p) local_unnamed_addr !dbg !133 {
entry:
    #dbg_value(ptr %p, !137, !DIExpression(), !138)
  %arrayidx = getelementptr inbounds nuw i8, ptr %p, i64 8, !dbg !139
  %0 = load i32, ptr %arrayidx, align 4, !dbg !140, !tbaa !141
  ret i32 %0, !dbg !142
}

define dso_local i128 @wide(ptr nofree noundef readonly captures(none) %p) local_unnamed_addr !dbg !143 {
entry:
    #dbg_value(ptr %p, !149, !DIExpression(), !150)
  %0 = load i128, ptr %p, align 16, !dbg !151, !tbaa !152
  ret i128 %0, !dbg !154
}

define dso_local i32 @vol(ptr nofree noundef captures(address) %p) local_unnamed_addr !dbg !155 {
entry:
    #dbg_value(ptr %p, !161, !DIExpression(), !162)
  %0 = load volatile i32, ptr %p, align 4, !dbg !163, !tbaa !164
  ret i32 %0, !dbg !165
}

define dso_local void @publish(ptr nofree noundef captures(none) %p, i64 noundef %v) local_unnamed_addr !dbg !166 {
entry:
    #dbg_value(ptr %p, !171, !DIExpression(), !173)
    #dbg_value(i64 %v, !172, !DIExpression(), !173)
  store atomic i64 %v, ptr %p release, align 8, !dbg !174
  ret void, !dbg !175
}


