## In a relocatable object every section starts at address 0 - a Linux kernel
## module's .text and .exit.text, say - so an address alone does not say which
## function a call site is in. Each call site is reported with its section,
## and resolved within it: its function, its descriptor and the source
## parameter it holds are the ones of that section's code, not of whatever
## lies at the same address in another section.

REQUIRES: x86-registered-target
RUN: split-file %s %t
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args %t/sections.ll -o %t/sections.bc
RUN: llc -O2 -filetype=obj %t/sections.bc -o %t/sections.o
RUN: sancov -symbolize-dataflow %t/sections.o | FileCheck %s

## The two functions have the same code, each at address 0 of its section, so
## their call sites have the same addresses.
CHECK:      "pc": "0x[[PC:[0-9a-f]+]]",
CHECK-NEXT: "section": ".text",
CHECK-NEXT: "kind": "args",
CHECK-NEXT: "frames": [
CHECK-NEXT:   {
CHECK-NEXT:     "function": "in_text",
CHECK:      "summary": "IR argument 0 -> source parameter \"count\" [exact: compiler source map]",
CHECK:      "pc": "0x[[PC1:[0-9a-f]+]]",
CHECK-NEXT: "section": ".text",
CHECK:      "summary": "IR argument 1 -> source parameter \"flags\" [exact: compiler source map]",
CHECK:      "pc": "0x[[PC]]",
CHECK-NEXT: "section": ".exit.text",
CHECK-NEXT: "kind": "args",
CHECK-NEXT: "frames": [
CHECK-NEXT:   {
CHECK-NEXT:     "function": "in_exit_text",
CHECK-NEXT:     "file": "/sections.c",
CHECK-NEXT:     "line": 5,
CHECK:      "summary": "IR argument 0 -> source parameter \"handle\" [exact: compiler source map]",
CHECK:      "pc": "0x[[PC1]]",
CHECK-NEXT: "section": ".exit.text",
CHECK:      "summary": "IR argument 1 -> source parameter \"mode\" [exact: compiler source map]",

;--- sections.ll
target triple = "x86_64-unknown-linux-gnu"

define i64 @in_text(i64 noundef %count, i32 noundef %flags) !dbg !10 {
    #dbg_value(i64 %count, !11, !DIExpression(), !13)
    #dbg_value(i32 %flags, !12, !DIExpression(), !13)
  %w = zext i32 %flags to i64
  %r = add i64 %count, %w, !dbg !13
  ret i64 %r, !dbg !13
}

define i64 @in_exit_text(i64 noundef %handle, i32 noundef %mode) section ".exit.text" !dbg !20 {
    #dbg_value(i64 %handle, !21, !DIExpression(), !22)
    #dbg_value(i32 %mode, !24, !DIExpression(), !22)
  %w = zext i32 %mode to i64
  %r = add i64 %handle, %w, !dbg !22
  ret i64 %r, !dbg !22
}

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2, !3}
!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, isOptimized: true, emissionKind: FullDebug)
!1 = !DIFile(filename: "sections.c", directory: "/")
!2 = !{i32 7, !"Dwarf Version", i32 5}
!3 = !{i32 2, !"Debug Info Version", i32 3}
!4 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
!5 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
!7 = !DISubroutineType(types: !8)
!8 = !{!4, !4, !5}
!10 = distinct !DISubprogram(name: "in_text", scope: !1, file: !1, line: 1, type: !7, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !14)
!11 = !DILocalVariable(name: "count", arg: 1, scope: !10, file: !1, line: 1, type: !4)
!12 = !DILocalVariable(name: "flags", arg: 2, scope: !10, file: !1, line: 1, type: !5)
!13 = !DILocation(line: 1, column: 1, scope: !10)
!14 = !{!11, !12}
!20 = distinct !DISubprogram(name: "in_exit_text", scope: !1, file: !1, line: 5, type: !7, scopeLine: 5, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !23)
!21 = !DILocalVariable(name: "handle", arg: 1, scope: !20, file: !1, line: 5, type: !4)
!22 = !DILocation(line: 5, column: 1, scope: !20)
!23 = !{!21, !24}
!24 = !DILocalVariable(name: "mode", arg: 2, scope: !20, file: !1, line: 5, type: !5)
