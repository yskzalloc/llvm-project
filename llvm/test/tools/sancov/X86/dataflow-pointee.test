    #dbg_value(ptr %p, !66, !DIExpression(), !67)
  %0 = load i64, ptr %p, align 8, !dbg !68, !tbaa !27
  %inc = add nsw i64 %0, 1, !dbg !69
  store i64 %inc, ptr %p, align 8, !dbg !70, !tbaa !27
