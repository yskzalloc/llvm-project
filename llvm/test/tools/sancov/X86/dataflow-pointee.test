define dso_local noundef i64 @_Z4areaRK5Point(ptr nofree noundef nonnull readonly align 8 captures(none) dereferenceable(16) %p) local_unnamed_addr #0 !dbg !13 {
entry:
    #dbg_value(ptr %p, !24, !DIExpression(), !25)
  %0 = load i64, ptr %p, align 8, !dbg !26, !tbaa !27
  %y = getelementptr inbounds nuw i8, ptr %p, i64 8, !dbg !26
  %1 = load i64, ptr %y, align 8, !dbg !26, !tbaa !30
