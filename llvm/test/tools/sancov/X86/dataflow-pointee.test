## Check that `sancov -symbolize-dataflow` cuts the raw bytes the runtime read
## behind a pointer - as many as the IR's dereferenceable(N) attribute said, at
## most -sanitizer-coverage-trace-pointee-bytes - into the members of what the
## debug information says the pointer points to: whole, in part, or not at all.
##
## The input is what clang -O2 -g emits for
##
##   struct Point { long x, y; };
##   struct Big { long a, b, c; };
##   long area(const Point &p) { return p.x * p.y; }   // dereferenceable(16)
##   long raw(const Point *q) { return q->x; }         // no attribute
##   long big(const Big &b) { return b.a + b.c; }      // dereferenceable(24)
##   Point &self(Point &p) { p.x++; return p; }        // and its return
##
## A pointer with no dereferenceable attribute is reported by value: none of
## its pointee was read.

REQUIRES: x86-registered-target
RUN: split-file %s %t
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args -sanitizer-coverage-trace-ret %t/pointee.ll -o %t/all.bc
RUN: llc -O2 -filetype=obj %t/all.bc -o %t/all.o
RUN: sancov -symbolize-dataflow %t/all.o | FileCheck %s --check-prefix=ALL

## Bounded to 12 bytes: the second member of every pointee is cut, the third
## of a Big not read.
RUN: opt -passes='module(sancov-module)' -sanitizer-coverage-trace-args -sanitizer-coverage-trace-ret \
RUN:   -sanitizer-coverage-trace-pointee-bytes=12 %t/pointee.ll -o %t/12.bc
RUN: llc -O2 -filetype=obj %t/12.bc -o %t/12.o
RUN: sancov -symbolize-dataflow %t/12.o | FileCheck %s --check-prefix=CUT

## Debug information stripped: the descriptor still says how many bytes were
## read behind which pointer; what they are is gone.
RUN: llvm-objcopy --strip-debug %t/all.o %t/stripped.o
RUN: sancov -symbolize-dataflow %t/stripped.o | FileCheck %s --check-prefix=STRIPPED

ALL:      "kind": "args"
ALL:      "function": "area(Point const&)"
ALL:      "class": "pointer",
ALL-NEXT: "size": 16,
ALL-NEXT: "flags": [
ALL-NEXT:   "pointee"
ALL-NEXT: ]
ALL:      "pointee": {
ALL-NEXT:   "type": "const Point",
ALL-NEXT:   "bytes_read": 16,
ALL-NEXT:   "fields": [
ALL-NEXT:     {
ALL-NEXT:       "name": "x",
ALL-NEXT:       "type": "long",
ALL-NEXT:       "bit_offset": 0,
ALL-NEXT:       "bit_size": 64
ALL-NEXT:     },
ALL-NEXT:     {
ALL-NEXT:       "name": "y",
ALL-NEXT:       "type": "long",
ALL-NEXT:       "bit_offset": 64,
ALL-NEXT:       "bit_size": 64
ALL-NEXT:     }
ALL-NEXT:   ]

ALL:      "kind": "args"
ALL:      "function": "raw(Point const*)"
ALL:      "class": "pointer",
ALL-NEXT: "size": 8,
ALL-NEXT: "flags": []
ALL:      "pointee": {
ALL-NEXT:   "type": "const Point",
ALL-NEXT:   "bytes_read": 0,
ALL:          "name": "x",
ALL:          "observed": false
ALL:          "name": "y",
ALL:          "observed": false

ALL:      "kind": "args"
ALL:      "function": "big(Big const&)"
ALL:      "size": 24,
ALL:      "bytes_read": 24,
ALL-NOT:  "observed"
ALL:      "kind": "ret"

## The returned reference: the descriptor says the value is the pointer, so
## its one piece is 64 bits, not the 16 bytes read behind it.
ALL:      "kind": "ret"
ALL:      "function": "self(Point&)"
ALL:      "class": "pointer",
ALL-NEXT: "size": 16,
ALL:      "type": "Point &",
ALL:      "bit_size": 64,
ALL-NEXT: "value_bit_offset": 0
ALL:      "pointee": {
ALL-NEXT:   "type": "Point",
ALL-NEXT:   "bytes_read": 16,

CUT:      "kind": "args"
CUT:      "function": "area(Point const&)"
CUT:      "bytes_read": 12,
CUT:        "name": "x",
CUT-NOT:    "complete"
CUT:        "name": "y",
CUT:        "bit_size": 64,
CUT-NEXT:   "complete": false
CUT:      "kind": "args"
CUT:      "function": "big(Big const&)"
CUT:      "bytes_read": 12,
CUT:        "name": "a",
CUT-NOT:    "complete"
CUT:        "name": "b",
CUT:        "bit_size": 64,
CUT-NEXT:   "complete": false
CUT:        "name": "c",
CUT:        "bit_size": 64,
CUT-NEXT:   "observed": false

STRIPPED:      "kind": "args"
STRIPPED:      "class": "pointer",
STRIPPED-NEXT: "size": 16,
STRIPPED-NEXT: "flags": [
STRIPPED-NEXT:   "pointee"
STRIPPED-NEXT: ]
STRIPPED-NOT:  "pointee": {
STRIPPED:      "provenance": "unresolved",

#--- pointee.ll
; ModuleID = 'pointee.cpp'
