    #dbg_value(ptr %b, !53, !DIExpression(), !54)
  %0 = load i64, ptr %b, align 8, !dbg !55, !tbaa !56
  %c = getelementptr inbounds nuw i8, ptr %b, i64 16, !dbg !55
  %1 = load i64, ptr %c, align 8, !dbg !55, !tbaa !58
