define dso_local noundef nonnull align 8 dereferenceable(16) ptr @_Z4selfR5Point(ptr nofree noundef nonnull returned align 8 captures(ret: address, provenance) dereferenceable(16) %p) local_unnamed_addr #1 !dbg !61 {
